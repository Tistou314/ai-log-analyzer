 "categories": {
  "search_engine": {
   "label": "Moteur de recherche",
   "explain": "Crawlers des moteurs classiques. Googlebot alimente aussi AI Overviews et AI Mode : il n'existe pas d'UA dédié à ces surfaces."
  },
  "ai_training": {
   "label": "LLM — entraînement",
   "explain": "Collecte de contenu pour entraîner des modèles. Aucun trafic en retour, aucune citation. C'est ce que Google-Extended / GPTBot / ClaudeBot permettent de bloquer sans perdre la visibilité recherche."
  },
  "ai_search": {
   "label": "LLM — index de recherche",
   "explain": "Construction d'un index pour citer vos pages dans les réponses (ChatGPT Search, Claude, Perplexity). Bloquer = disparaître des citations."
  },
  "ai_user_fetch": {
   "label": "LLM — fetch utilisateur",
   "explain": "Un humain a demandé quelque chose à une IA, qui est venue lire votre page en temps réel. Souvent hors robots.txt par design (comme un navigateur). C'est le signal le plus proche d'une visibilité IA réelle."
  },
  "ai_agent": {
   "label": "Agent IA",
   "explain": "Agent autonome qui navigue, compare ou agit (Google-Agent, Mariner, Operator). Nouveau type de trafic 2026 : attribution et conversion à surveiller."
  },
  "seo_tool": {
   "label": "Outil SEO",
   "explain": "Ahrefs, Semrush, Majestic… Utile pour vous, coûteux en crawl budget, et révèle si des concurrents vous auditent."
  },
  "social_preview": {
   "label": "Aperçu social/messagerie",
   "explain": "Un lien a été partagé quelque part. Bon proxy de partage réel."
  },
  "monitoring": {
   "label": "Monitoring / perf",
   "explain": "Surveillance, tests de vitesse, health checks."
  },
  "scraper": {
   "label": "Scraper / scanner",
   "explain": "Scripts génériques, headless, scanners de vulnérabilités. À traiter côté sécurité plutôt que SEO."
  },
  "other_bot": {
   "label": "Autre bot",
   "explain": "Bot identifié comme tel mais absent de la base. À examiner : c'est là que se cachent les nouveaux crawlers IA."
  },
  "human": {
   "label": "Humain (probable)",
   "explain": "UA navigateur sans marqueur de bot. Voir le module stealth pour les bots déguisés."
  }
 }
